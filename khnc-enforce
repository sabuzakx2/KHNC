#!/bin/sh
# KHNC parental policy evaluator.  It is invoked after a policy save and by
# the khnc-parental service once per minute so time windows change on time.
. /usr/share/libubox/jshn.sh

POLICY_FILE="/etc/khnc/policies.json"
STATE_DIR="/etc/khnc/runtime"
TABLE="khnc_parental"
TODAY="$(date +%F)"
NOW_EPOCH="$(date +%s)"
DAY_NUM="$(date +%u)"
NOW_H="$(date +%H)"; NOW_M="$(date +%M)"
NOW_H="${NOW_H#0}"; NOW_M="${NOW_M#0}"
[ -n "$NOW_H" ] || NOW_H=0; [ -n "$NOW_M" ] || NOW_M=0
NOW_MIN=$((NOW_H * 60 + NOW_M))

log_msg() { logger -t khnc-parental "$*"; }
bool_true() { [ "$1" = "1" ] || [ "$1" = "true" ]; }
valid_mac() { case "$1" in [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) return 0;; *) return 1;; esac; }
to_minutes() {
  value="${1:-00:00}"; hour="${value%%:*}"; minute="${value##*:}"
  case "$hour" in ''|*[!0-9]*) hour=0;; esac; case "$minute" in ''|*[!0-9]*) minute=0;; esac
  hour="${hour#0}"; minute="${minute#0}"; [ -n "$hour" ] || hour=0; [ -n "$minute" ] || minute=0
  [ "$hour" -le 23 ] 2>/dev/null || hour=23; [ "$minute" -le 59 ] 2>/dev/null || minute=59
  echo $((hour * 60 + minute))
}
in_window() {
  start="$1"; end="$2"; now="$3"
  # A time input cannot express 24:00.  Treat equal start/end values as a
  # complete day so 00:00~00:00 never accidentally blocks all internet.
  [ "$start" -eq "$end" ] && return 0
  if [ "$start" -lt "$end" ]; then
    [ "$now" -ge "$start" ] && [ "$now" -lt "$end" ]
  else
    [ "$now" -ge "$start" ] || [ "$now" -lt "$end" ]
  fi
}
device_seen() {
  mac="$(printf '%s' "$1" | tr 'A-F' 'a-f')"
  ip neigh show 2>/dev/null | tr 'A-F' 'a-f' | grep -Fq "$mac" && return 0
  bridge fdb show 2>/dev/null | tr 'A-F' 'a-f' | grep -Fq "$mac"
}

command -v nft >/dev/null 2>&1 || { echo "nft 명령이 없습니다."; exit 1; }
mkdir -p "$STATE_DIR/$TODAY"
find "$STATE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name "$TODAY" -mtime +2 -exec rm -rf {} \; 2>/dev/null

WAN_IFS=""
for network in wan wan6; do
  status="$(ubus call network.interface.$network status 2>/dev/null)"
  device="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
  [ -n "$device" ] || device="$(printf '%s' "$status" | jsonfilter -e '@.device' 2>/dev/null)"
  [ -n "$device" ] && WAN_IFS="$WAN_IFS $device"
done
WAN_IFS="$(printf '%s\n' $WAN_IFS | awk 'NF&&!seen[$0]++' | xargs)"
[ -n "$WAN_IFS" ] || { echo "WAN 인터페이스를 찾지 못했습니다."; exit 1; }

BLOCKED=""
if [ -s "$POLICY_FILE" ]; then
  json_init
  if json_load_file "$POLICY_FILE" 2>/dev/null; then
    json_select policies 2>/dev/null || true
    json_get_keys ITEMS
    for ITEM in $ITEMS; do
      json_select "$ITEM" || continue
      json_get_var MAC mac; json_get_var ENABLED scheduleEnabled; json_get_var OVERRIDE override
      json_get_var BONUS_DATE bonusDate; json_get_var BONUS_MIN bonusMinutes; json_get_var UNLIMITED_DATE unlimitedDate
      SHOULD_BLOCK=0; WINDOW_BLOCKED=0; PERIOD="weekday"; [ "$DAY_NUM" -ge 6 ] && PERIOD="weekend"
      SAFE_MAC="$(printf '%s' "$MAC" | tr 'A-F:' 'a-f_')"
      STATE_FILE="$STATE_DIR/$TODAY/$SAFE_MAC"
      case "$OVERRIDE" in
        block) SHOULD_BLOCK=1; WINDOW_BLOCKED=1 ;;
        allow) SHOULD_BLOCK=0 ;;
        *)
          if bool_true "$ENABLED"; then
            PERIOD_SELECTED=0
            if json_select periods 2>/dev/null && json_select "$PERIOD" 2>/dev/null; then
              PERIOD_SELECTED=1
              json_get_var PERIOD_ENABLED enabled; json_get_var MODE mode; json_get_var ALL_DAY allDay
              json_get_var START start; json_get_var END end; json_get_var LIMIT limitMinutes
              json_select .. 2>/dev/null; json_select .. 2>/dev/null
            fi
            # A missing or disabled period must stay blocked, never fall
            # through with stale values from a different device policy.
            if [ "$PERIOD_SELECTED" -ne 1 ] || ! bool_true "$PERIOD_ENABLED"; then
              SHOULD_BLOCK=1; WINDOW_BLOCKED=1
            else
              [ "$MODE" = "block" ] || MODE="allow"
              if bool_true "$ALL_DAY"; then
                if [ "$MODE" = "block" ]; then SHOULD_BLOCK=1; WINDOW_BLOCKED=1; else SHOULD_BLOCK=0; fi
              else
                START_MIN="$(to_minutes "${START:-00:00}")"; END_MIN="$(to_minutes "${END:-23:59}")"
                if [ "$MODE" = "block" ]; then
                  if in_window "$START_MIN" "$END_MIN" "$NOW_MIN"; then SHOULD_BLOCK=1; WINDOW_BLOCKED=1; else SHOULD_BLOCK=0; fi
                elif ! in_window "$START_MIN" "$END_MIN" "$NOW_MIN"; then
                  SHOULD_BLOCK=1; WINDOW_BLOCKED=1
                fi
              fi
            fi
            # A scheduled block ends the continuous-use session.  Without
            # this reset an earlier all-day session can incorrectly appear as
            # 20+ hours after the user changes to a time window.
            [ "$WINDOW_BLOCKED" -eq 1 ] && rm -f "$STATE_FILE"
            if [ "$SHOULD_BLOCK" -eq 0 ] && [ "$UNLIMITED_DATE" != "$TODAY" ]; then
              case "$LIMIT" in ''|*[!0-9]*) LIMIT=0;; esac; case "$BONUS_MIN" in ''|*[!0-9]*) BONUS_MIN=0;; esac
              [ "$BONUS_DATE" = "$TODAY" ] || BONUS_MIN=0
              TOTAL_LIMIT=$((LIMIT + BONUS_MIN))
              START_EPOCH=""; [ -s "$STATE_FILE" ] && START_EPOCH="$(cat "$STATE_FILE" 2>/dev/null)"
              if [ -z "$START_EPOCH" ] && device_seen "$MAC"; then START_EPOCH="$NOW_EPOCH"; printf '%s\n' "$START_EPOCH" > "$STATE_FILE"; fi
              if [ -n "$START_EPOCH" ] && [ "$TOTAL_LIMIT" -gt 0 ]; then USED=$(( (NOW_EPOCH - START_EPOCH) / 60 )); [ "$USED" -lt "$TOTAL_LIMIT" ] || SHOULD_BLOCK=1; fi
            fi
          fi
          ;;
      esac
      if valid_mac "$MAC" && [ "$SHOULD_BLOCK" -eq 1 ]; then BLOCKED="$BLOCKED $(printf '%s' "$MAC" | tr 'A-F' 'a-f')"; fi
      json_select ..
    done
  fi
fi

nft delete table inet "$TABLE" 2>/dev/null || true
nft add table inet "$TABLE" || exit 1
nft "add set inet $TABLE blocked_macs { type ether_addr; }" || exit 1
nft "add chain inet $TABLE forward { type filter hook forward priority -5; policy accept; }" || exit 1
for IFACE in $WAN_IFS; do
  nft add rule inet "$TABLE" forward oifname "$IFACE" ether saddr @blocked_macs counter reject 2>/dev/null || nft add rule inet "$TABLE" forward oifname "$IFACE" ether saddr @blocked_macs counter drop || exit 1
done
BLOCKED="$(printf '%s\n' $BLOCKED | awk 'NF&&!seen[$0]++' | xargs)"
if [ -n "$BLOCKED" ]; then ELEMENTS="$(printf '%s' "$BLOCKED" | sed 's/ /, /g')"; nft "add element inet $TABLE blocked_macs { $ELEMENTS }" || exit 1; fi
COUNT="$(printf '%s\n' $BLOCKED | awk 'NF{n++}END{print n+0}')"
log_msg "정책 적용 완료: 차단 $COUNT대, 현재 $NOW_H:$NOW_M, WAN: $WAN_IFS"
echo "정책 적용 완료: 차단 $COUNT대"
