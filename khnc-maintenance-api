#!/bin/sh
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

CONF=/etc/khnc/maintenance.conf
STATUS=/tmp/khnc-maintenance.status
WORKER=/usr/libexec/khnc-maintenance-worker
CRON=/etc/crontabs/root
LOG_DIR=/etc/khnc/backup-logs

esc(){ printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g;s/\r//g' | awk 'NR>1{printf "\\n"}{printf "%s",$0}'; }
decode(){ printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g;s/%/\\x/g')"; }
param(){ printf '%s' "$PARAMS" | tr '&' '\n' | awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}' | while IFS= read -r v; do decode "$v"; done; }
fail(){ printf '{"ok":false,"error":"%s"}' "$(esc "$1")"; exit 0; }
bool(){ [ "${1:-1}" -eq 0 ] 2>/dev/null && printf true || printf false; }
valid_host(){ printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._:-]+$'; }
valid_user(){ printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]+$'; }
valid_path(){ printf '%s' "$1" | grep -Eq '^[/A-Za-z0-9._ -]+$'; }
valid_file(){ printf '%s' "$1" | grep -Eq '^khnc-[A-Za-z0-9._-]+\.img\.gz$'; }

METHOD="${REQUEST_METHOD:-GET}"
QUERY_PARAMS="${QUERY_STRING:-}"
PARAMS="$QUERY_PARAMS"
if [ "$METHOD" = POST ]; then
  LENGTH="${CONTENT_LENGTH:-0}"
  case "$LENGTH" in ''|*[!0-9]*) LENGTH=0;; esac
  BODY="$(dd bs=1 count="$LENGTH" 2>/dev/null)"
  if [ -n "$QUERY_PARAMS" ] && [ -n "$BODY" ]; then PARAMS="$QUERY_PARAMS&$BODY"
  elif [ -n "$BODY" ]; then PARAMS="$BODY"
  else PARAMS="$QUERY_PARAMS"
  fi
fi
ACTION="$(param action)"; ACTION="${ACTION:-status}"

load_config(){
  BACKUP_PROTOCOL=ssh; NAS_HOST=192.168.1.10; NAS_USER=kallos; NAS_PORT=2202; NAS_KEY=/root/.ssh/khnc_nas_key
  REMOTE_PATH=KHNC_Backup; SMB_SHARE=//192.168.1.10/backup; SMB_AUTH=/etc/khnc/smb.auth
  RETENTION=5; SCHEDULE_ENABLED=0; SCHEDULE_DAY=0; SCHEDULE_TIME=03:30
  [ -r "$CONF" ] && . "$CONF"
}
load_config

disk_info(){
  MOUNT_DEV="$(df -P /overlay 2>/dev/null | awk 'NR==2 {print $1}')"
  case "$MOUNT_DEV" in /dev/*) :;; *) MOUNT_DEV="$(awk '$2=="/overlay" && $1 ~ /^\/dev\// {print $1; exit}' /proc/mounts)";; esac
  if [ -z "$MOUNT_DEV" ] && command -v block >/dev/null 2>&1; then MOUNT_DEV="$(block info 2>/dev/null | awk -F: '/MOUNT="\/overlay"/ {print $1; exit}')"; fi
  case "$MOUNT_DEV" in /dev/sd[a-z][0-9]*) DISK_DEV="${MOUNT_DEV%[0-9]*}";; /dev/mmcblk*p[0-9]*) DISK_DEV="${MOUNT_DEV%p[0-9]*}";; /dev/nvme*n*p[0-9]*) DISK_DEV="${MOUNT_DEV%p[0-9]*}";; /dev/*) DISK_DEV="$MOUNT_DEV";; *) DISK_DEV='';; esac
  BASE="${DISK_DEV#/dev/}"; SECTORS="$(cat "/sys/class/block/$BASE/size" 2>/dev/null || echo 0)"; DISK_SIZE=$((SECTORS * 512))
}

ssh_cmd(){ ssh -p "$NAS_PORT" -i "$NAS_KEY" "$NAS_USER@$NAS_HOST" "$1" </dev/null; }

case "$ACTION" in
  config)
    printf '{"ok":true,"config":{"protocol":"%s","nasHost":"%s","nasUser":"%s","nasPort":%s,"nasKey":"%s","remotePath":"%s","smbShare":"%s","smbAuth":"%s","retention":%s,"scheduleEnabled":%s,"scheduleDay":%s,"scheduleTime":"%s"}}' \
      "$(esc "$BACKUP_PROTOCOL")" "$(esc "$NAS_HOST")" "$(esc "$NAS_USER")" "$NAS_PORT" "$(esc "$NAS_KEY")" "$(esc "$REMOTE_PATH")" "$(esc "$SMB_SHARE")" "$(esc "$SMB_AUTH")" "$RETENTION" "$SCHEDULE_ENABLED" "$SCHEDULE_DAY" "$(esc "$SCHEDULE_TIME")"
  ;;
  save-config)
    PROTOCOL="$(param protocol)"; HOST="$(param nasHost)"; USER="$(param nasUser)"; PORT="$(param nasPort)"; KEY="$(param nasKey)"; PATH_VALUE="$(param remotePath)"; SHARE="$(param smbShare)"; AUTH="$(param smbAuth)"; KEEP="$(param retention)"; ENABLED="$(param scheduleEnabled)"; DAY="$(param scheduleDay)"; TIME_VALUE="$(param scheduleTime)"
    [ "$PROTOCOL" = ssh ] || [ "$PROTOCOL" = smb ] || fail '지원하지 않는 전송 방식입니다.'
    valid_host "$HOST" || fail 'NAS 주소 형식이 올바르지 않습니다.'; valid_user "$USER" || fail 'SSH 사용자 형식이 올바르지 않습니다.'
    printf '%s' "$PORT" | grep -Eq '^[0-9]{1,5}$' || fail 'SSH 포트가 올바르지 않습니다.'; [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || fail 'SSH 포트는 1~65535입니다.'; valid_path "$KEY" || fail 'SSH 키 경로가 올바르지 않습니다.'; valid_path "$PATH_VALUE" || fail '원격 경로가 올바르지 않습니다.'; valid_path "$AUTH" || fail 'SMB 인증파일 경로가 올바르지 않습니다.'
    printf '%s' "$SHARE" | grep -Eq '^//[A-Za-z0-9._:-]+/[A-Za-z0-9._ -]+$' || fail 'SMB 공유 형식이 올바르지 않습니다.'
    printf '%s' "$KEEP" | grep -Eq '^[0-9]{1,3}$' || fail '보관 개수가 올바르지 않습니다.'; [ "$KEEP" -ge 1 ] && [ "$KEEP" -le 100 ] || fail '보관 개수는 1~100입니다.'
    [ "$ENABLED" = 0 ] || [ "$ENABLED" = 1 ] || fail '예약 설정이 올바르지 않습니다.'; printf '%s' "$DAY" | grep -Eq '^[0-6]$' || fail '요일이 올바르지 않습니다.'; printf '%s' "$TIME_VALUE" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$' || fail '시간이 올바르지 않습니다.'
    mkdir -p /etc/khnc; umask 077
    cat > "$CONF" <<EOF
BACKUP_PROTOCOL='$PROTOCOL'
NAS_HOST='$HOST'
NAS_USER='$USER'
NAS_PORT='$PORT'
NAS_KEY='$KEY'
REMOTE_PATH='$PATH_VALUE'
SMB_SHARE='$SHARE'
SMB_AUTH='$AUTH'
RETENTION='$KEEP'
SCHEDULE_ENABLED='$ENABLED'
SCHEDULE_DAY='$DAY'
SCHEDULE_TIME='$TIME_VALUE'
EOF
    mkdir -p "$(dirname "$CRON")"; touch "$CRON"; sed -i '/# KHNC-MAINTENANCE$/d' "$CRON"
    if [ "$ENABLED" = 1 ]; then MINUTE="${TIME_VALUE#*:}"; HOUR="${TIME_VALUE%:*}"; printf '%s %s * * %s %s scheduled # KHNC-MAINTENANCE\n' "$MINUTE" "$HOUR" "$DAY" "$WORKER" >> "$CRON"; fi
    /etc/init.d/cron restart >/dev/null 2>&1 || true
    printf '{"ok":true}'
  ;;
  test-nas)
    if [ "$BACKUP_PROTOCOL" = smb ]; then command -v smbclient >/dev/null 2>&1 || fail 'smbclient 패키지가 필요합니다.'; smbclient "$SMB_SHARE" -A "$SMB_AUTH" -c 'ls' >/dev/null 2>&1; RC=$?; TARGET="$SMB_SHARE/${REMOTE_PATH#/}"
    else [ -r "$NAS_KEY" ] || fail 'SSH 키 파일을 읽을 수 없습니다.'; TARGET="$(ssh_cmd "mkdir -p '$REMOTE_PATH' && cd '$REMOTE_PATH' && test -w . && pwd" 2>/dev/null)"; RC=$?; fi
    [ "$RC" -eq 0 ] && printf '{"ok":true,"message":"NAS 연결 정상 · %s"}' "$(esc "$TARGET")" || fail 'NAS 연결 또는 쓰기 권한을 확인하세요.'
  ;;
  start)
    [ -x "$WORKER" ] || fail '백업 워커가 설치되지 않았습니다.'; [ ! -d /tmp/khnc-maintenance.lock ] || fail '이미 백업이 실행 중입니다.'
    rm -f "$STATUS"
    if command -v start-stop-daemon >/dev/null 2>&1; then
      start-stop-daemon -S -b -x "$WORKER" -- manual >/dev/null 2>&1
    elif command -v nohup >/dev/null 2>&1; then
      nohup "$WORKER" manual >/dev/null 2>&1 &
    else
      "$WORKER" manual </dev/null >/dev/null 2>&1 &
    fi
    sleep 1
    if [ -r "$STATUS" ] || [ -d /tmp/khnc-maintenance.lock ]; then printf '{"ok":true,"message":"SSD 백업을 시작했습니다."}'
    else fail '백업 워커가 시작 직후 종료됐습니다. extroot 장치와 워커 실행 환경을 확인하세요.'
    fi
  ;;
  history)
    if [ "$BACKUP_PROTOCOL" = smb ]; then
      command -v smbclient >/dev/null 2>&1 || fail 'smbclient 패키지가 필요합니다.'
      RAW="$(smbclient "$SMB_SHARE" -A "$SMB_AUTH" -c "cd ${REMOTE_PATH#/}; ls khnc-*.img.gz" 2>/dev/null | awk '$1 ~ /^khnc-.*\.img\.gz$/ {print $1 "|" $2 "|yes"}' | sort -r)" || fail 'SMB 백업 이력을 읽지 못했습니다.'
    else
      RAW="$(ssh_cmd "mkdir -p '$REMOTE_PATH'; cd '$REMOTE_PATH' && for f in \$(ls -1t khnc-*.img.gz 2>/dev/null | head -n 100); do size=\$(stat -c %s \"\$f\" 2>/dev/null || wc -c < \"\$f\"); sha=no; test -f \"\$f.sha256\" && sha=yes; printf '%s|%s|%s\\n' \"\$f\" \"\$size\" \"\$sha\"; done" 2>/dev/null)" || fail 'NAS 백업 이력을 읽지 못했습니다.'
    fi
    printf '{"ok":true,"items":['; FIRST=1
    printf '%s\n' "$RAW" | while IFS='|' read -r FILE SIZE SHA; do [ -n "$FILE" ] || continue; [ "$FIRST" -eq 1 ] || printf ','; FIRST=0; printf '{"file":"%s","size":%s,"sha256":%s}' "$(esc "$FILE")" "${SIZE:-0}" "$([ "$SHA" = yes ] && echo true || echo false)"; done
    printf ']}'
  ;;
  verify)
    FILE="$(param file)"; valid_file "$FILE" || fail '백업 파일명이 올바르지 않습니다.'
    if [ "$BACKUP_PROTOCOL" = smb ]; then
      EXPECTED="$(smbclient "$SMB_SHARE" -A "$SMB_AUTH" -c "cd ${REMOTE_PATH#/}; get $FILE.sha256 -" 2>/dev/null | awk 'length($1)==64 && $1 ~ /^[0-9A-Fa-f]+$/ {print $1; exit}')"
      ACTUAL="$(smbclient "$SMB_SHARE" -A "$SMB_AUTH" -c "cd ${REMOTE_PATH#/}; get $FILE -" 2>/dev/null | sha256sum | awk '{print $1}')"
      [ -n "$EXPECTED" ] && [ "$EXPECTED" = "$ACTUAL" ]; RC=$?; OUT="$FILE: $([ "$RC" -eq 0 ] && echo OK || echo FAILED)"
    else OUT="$(ssh_cmd "cd '$REMOTE_PATH' && sha256sum -c '$FILE.sha256'" 2>&1)"; RC=$?; fi
    [ "$RC" -eq 0 ] && printf '{"ok":true,"message":"%s"}' "$(esc "$OUT")" || fail "$OUT"
  ;;
  restore-command)
    FILE="$(param file)"; valid_file "$FILE" || fail '백업 파일명이 올바르지 않습니다.'; TARGET_DEVICE=/dev/REPLACE_WITH_TARGET_DISK
    if [ "$BACKUP_PROTOCOL" = ssh ]; then CMD="ssh -p $NAS_PORT -i $NAS_KEY $NAS_USER@$NAS_HOST \"cat '$REMOTE_PATH/$FILE'\" | gzip -dc | dd of=$TARGET_DEVICE bs=4M conv=fsync status=progress"
    else CMD="smbclient '$SMB_SHARE' -A '$SMB_AUTH' -c \"cd ${REMOTE_PATH#/}; get '$FILE' -\" | gzip -dc | dd of=$TARGET_DEVICE bs=4M conv=fsync status=progress"; fi
    printf '{"ok":true,"warning":"대상 디스크의 모든 데이터가 덮어써집니다. KHNC에서는 이 명령을 실행하지 않습니다.","command":"%s"}' "$(esc "$CMD")"
  ;;
  status)
    disk_info; STATE=idle; FILE=''; TOTAL=0; READ_BYTES=0; PERCENT=0; SPEED=0; ETA=0; FINAL_SIZE=0; STARTED=0; FINISHED=0; MESSAGE='대기'; LOG=''
    if [ -r "$STATUS" ]; then STATE="$(sed -n 's/^state=//p' "$STATUS")"; FILE="$(sed -n 's/^file=//p' "$STATUS")"; TOTAL="$(sed -n 's/^total=//p' "$STATUS")"; READ_BYTES="$(sed -n 's/^read=//p' "$STATUS")"; PERCENT="$(sed -n 's/^percent=//p' "$STATUS")"; SPEED="$(sed -n 's/^speed=//p' "$STATUS")"; ETA="$(sed -n 's/^eta=//p' "$STATUS")"; FINAL_SIZE="$(sed -n 's/^final_size=//p' "$STATUS")"; STARTED="$(sed -n 's/^started=//p' "$STATUS")"; FINISHED="$(sed -n 's/^finished=//p' "$STATUS")"; MESSAGE="$(sed -n 's/^message=//p' "$STATUS")"; LOG="$(sed -n 's/^log=//p' "$STATUS")"; fi
    LOG_TEXT=''; [ -r "$LOG" ] && LOG_TEXT="$(tail -n 40 "$LOG")"
    printf '{"ok":true,"disk":{"mountDevice":"%s","device":"%s","size":%s,"detected":%s},"job":{"state":"%s","file":"%s","total":%s,"read":%s,"percent":%s,"speed":%s,"eta":%s,"finalSize":%s,"started":%s,"finished":%s,"message":"%s","log":"%s"}}' "$(esc "$MOUNT_DEV")" "$(esc "$DISK_DEV")" "$DISK_SIZE" "$([ -n "$DISK_DEV" ] && echo true || echo false)" "$(esc "$STATE")" "$(esc "$FILE")" "${TOTAL:-0}" "${READ_BYTES:-0}" "${PERCENT:-0}" "${SPEED:-0}" "${ETA:-0}" "${FINAL_SIZE:-0}" "${STARTED:-0}" "${FINISHED:-0}" "$(esc "$MESSAGE")" "$(esc "$LOG_TEXT")"
  ;;
  *) fail '지원하지 않는 작업입니다.';;
esac
