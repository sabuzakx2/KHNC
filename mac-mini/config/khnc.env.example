ROUTER_PORT=2222
ROUTER_USER=root
ROUTER_KEY=/run/secrets/khnc_ax53u_key
# Optional wired-backhaul OpenWrt APs. KHNC merges their live Wi-Fi stations
# with AX53U DHCP/LAN information. Authorize ROUTER_KEY on each AP, then set
# its IP below. Keep this as [] when AX53U is the only wireless access point.
# WIFI_APS=[{"name":"WHW03-01","host":"192.168.1.2","port":2202,"user":"root","key":"/run/secrets/khnc_whw03_01_key"}]
# WIFI_AP_KEY=/run/secrets/khnc_ax53u_key
N2830_HOST=192.168.1.106
N2830_PORT=22
N2830_USER=kallos
N2830_KEY=/run/secrets/khnc_n2830_key
