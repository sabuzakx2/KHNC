#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/uhttpd
DOCROOT=/usr/share/khnc/www
PORT=8881
MOBILE_DOCROOT=/usr/share/khnc/mobile
MOBILE_PORT=8882

start_httpd() {
  NAME="$1"
  ROOT="$2"
  LISTEN_PORT="$3"

  [ -r "$ROOT/index.html" ] || return 1
  procd_open_instance "$NAME"
  procd_set_param command "$PROG" \
    -f \
    -h "$ROOT" \
    -r KHNC \
    -x /cgi-bin \
    -p "0.0.0.0:$LISTEN_PORT" \
    -t 60 \
    -T 30
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

start_service() {
  [ -x "$PROG" ] || return 1
  start_httpd desktop "$DOCROOT" "$PORT"
  start_httpd mobile "$MOBILE_DOCROOT" "$MOBILE_PORT"
}

service_triggers() {
  procd_add_reload_trigger khnc
}
