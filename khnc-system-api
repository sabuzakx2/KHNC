#!/bin/sh
. /usr/share/libubox/jshn.sh

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

BOARD="$(ubus call system board 2>/dev/null)"
INFO="$(ubus call system info 2>/dev/null)"

getj() { jsonfilter -s "$1" -e "$2" 2>/dev/null; }
num_or_zero() { case "$1" in ''|*[!0-9]*) echo 0;; *) echo "$1";; esac; }

HOSTNAME="$(getj "$BOARD" '@.hostname')"
MODEL="$(getj "$BOARD" '@.model')"
KERNEL="$(getj "$BOARD" '@.kernel')"
VERSION="$(getj "$BOARD" '@.release.version')"
REVISION="$(getj "$BOARD" '@.release.revision')"
UPTIME="$(getj "$INFO" '@.uptime')"
LOAD1="$(getj "$INFO" '@.load[0]')"
LOAD5="$(getj "$INFO" '@.load[1]')"
LOAD15="$(getj "$INFO" '@.load[2]')"
MEM_TOTAL="$(getj "$INFO" '@.memory.total')"
MEM_FREE="$(getj "$INFO" '@.memory.free')"
MEM_SHARED="$(getj "$INFO" '@.memory.shared')"
MEM_BUFFERED="$(getj "$INFO" '@.memory.buffered')"
MEM_AVAILABLE="$(getj "$INFO" '@.memory.available')"

# Router address priority: IPv4 LAN, global IPv6, then link-local IPv6.
LAN_IPV4="$(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet 192\.168\./ {sub(/\/.*/,"",$2); print $2; exit}')"
LAN_IPV6_GLOBAL="$(ip -6 addr show dev br-lan scope global 2>/dev/null | awk '/inet6 / {sub(/\/.*/,"",$2); print $2; exit}')"
LAN_IPV6_LINK="$(ip -6 addr show dev br-lan scope link 2>/dev/null | awk '/inet6 fe80:/ {sub(/\/.*/,"",$2); print $2; exit}')"
if [ -n "$LAN_IPV4" ]; then LAN_ADDRESS="$LAN_IPV4"
elif [ -n "$LAN_IPV6_GLOBAL" ]; then LAN_ADDRESS="$LAN_IPV6_GLOBAL"
else LAN_ADDRESS="$LAN_IPV6_LINK"
fi

# BusyBox top already reports the router's current CPU snapshot.  Using it
# avoids a one-second /proc/stat sample that was easily skewed by KHNC's own
# short CGI/SSH activity.
CPU_IDLE="$(top -bn1 2>/dev/null | awk '/^CPU:/ { for (i=1;i<=NF;i++) if ($i=="idle") {v=$(i-1); gsub(/%/,"",v); print v; exit} }')"
case "$CPU_IDLE" in
  ''|*[!0-9]*) CPU_PERCENT=0 ;;
  *) CPU_PERCENT=$((100-CPU_IDLE)); [ "$CPU_PERCENT" -ge 0 ] || CPU_PERCENT=0 ;;
esac

# extroot 또는 /overlay에 실제 연결된 블록 장치를 찾는다.
# overlayfs가 /proc/mounts에 먼저 보이는 환경을 고려해 df 결과를 우선 사용한다.
DF_DEVICE="$(df -P /overlay 2>/dev/null | awk 'NR==2 {print $1}')"
case "$DF_DEVICE" in
  /dev/*) STORAGE_DEVICE="$DF_DEVICE" ;;
  *) STORAGE_DEVICE="" ;;
esac

if [ -z "$STORAGE_DEVICE" ]; then
  STORAGE_DEVICE="$(awk '$2=="/overlay" && $1 ~ /^\/dev\// {print $1; exit}' /proc/mounts)"
fi
if [ -z "$STORAGE_DEVICE" ] && command -v block >/dev/null 2>&1; then
  STORAGE_DEVICE="$(block info 2>/dev/null | awk -F: '/MOUNT="\/overlay"/ {print $1; exit}')"
fi

STORAGE_MOUNT="/overlay"
STORAGE_FS="$(awk -v dev="$STORAGE_DEVICE" '$1==dev {print $3; exit}' /proc/mounts)"
if [ -z "$STORAGE_FS" ] && command -v block >/dev/null 2>&1; then
  STORAGE_FS="$(block info "$STORAGE_DEVICE" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')"
fi
STORAGE_MOUNTED=0
case "$STORAGE_DEVICE" in /dev/*) STORAGE_MOUNTED=1 ;; esac

TOTAL_KB=0 USED_KB=0 AVAIL_KB=0 USED_PERCENT=0 TOTAL_HUMAN="-" USED_HUMAN="-" AVAIL_HUMAN="-"
if [ "$STORAGE_MOUNTED" -eq 1 ]; then
  DF_LINE="$(df -k "$STORAGE_MOUNT" 2>/dev/null | awk 'NR==2 {print}')"
  TOTAL_KB="$(printf '%s\n' "$DF_LINE" | awk '{print $2}')"
  USED_KB="$(printf '%s\n' "$DF_LINE" | awk '{print $3}')"
  AVAIL_KB="$(printf '%s\n' "$DF_LINE" | awk '{print $4}')"
  USED_PERCENT="$(printf '%s\n' "$DF_LINE" | awk '{gsub(/%/,"",$5); print $5}')"
  TOTAL_HUMAN="$(df -h "$STORAGE_MOUNT" 2>/dev/null | awk 'NR==2 {print $2}')"
  USED_HUMAN="$(df -h "$STORAGE_MOUNT" 2>/dev/null | awk 'NR==2 {print $3}')"
  AVAIL_HUMAN="$(df -h "$STORAGE_MOUNT" 2>/dev/null | awk 'NR==2 {print $4}')"
fi

SMART_AVAILABLE=0
SMART_HEALTH=""
SMART_TEMP=""
SMART_HOURS=""
SMART_MODEL=""
SMART_SERIAL=""
SMART_POWER_CYCLES=""
SMART_REASON=""
SMART_DEV="$STORAGE_DEVICE"
SMART_CHECKED_AT=""
SMART_SELF_TEST_TYPE=""
SMART_SELF_TEST_STATUS=""
SMART_SELF_TEST_HOURS=""

SMART_LAST_TEST=""
if [ -r /etc/khnc/smart.json ]; then
  SMART_LAST_TEST="$(jsonfilter -i /etc/khnc/smart.json -e '@.timestamp' 2>/dev/null)"
fi

# 파티션(/dev/sda1) 대신 디스크(/dev/sda)를 검사한다.
case "$SMART_DEV" in
  /dev/sd[a-z][0-9]*) SMART_DEV="${SMART_DEV%[0-9]*}" ;;
  /dev/mmcblk*p[0-9]*) SMART_DEV="${SMART_DEV%p[0-9]*}" ;;
  /dev/nvme*n*p[0-9]*) SMART_DEV="${SMART_DEV%p[0-9]*}" ;;
esac

if [ "$STORAGE_MOUNTED" -ne 1 ]; then
  SMART_REASON="연결된 저장장치를 찾지 못했습니다."
elif ! command -v smartctl >/dev/null 2>&1; then
  SMART_REASON="smartctl이 설치되지 않았습니다. smartmontools 패키지가 필요합니다."
else
  SMART_DEVICE_TYPE=""
  SMART_JSON="$(smartctl -a -j "$SMART_DEV" 2>/dev/null)"
  if [ -z "$SMART_JSON" ] || ! printf '%s' "$SMART_JSON" | grep -q '"smart_status"'; then
    # ASMedia 등 USB-SATA 브리지는 SAT 지정이 필요할 수 있다.
    SMART_JSON="$(smartctl -a -j -d sat "$SMART_DEV" 2>/dev/null)"
    [ -n "$SMART_JSON" ] && SMART_DEVICE_TYPE="sat"
  fi
  if [ -n "$SMART_JSON" ]; then
    SMART_CHECKED_AT="$(date +%s)"
    SMART_PASSED="$(getj "$SMART_JSON" '@.smart_status.passed')"
    SMART_TEMP="$(getj "$SMART_JSON" '@.temperature.current')"
    SMART_HOURS="$(getj "$SMART_JSON" '@.power_on_time.hours')"
    SMART_MODEL="$(getj "$SMART_JSON" '@.model_name')"
    [ -n "$SMART_MODEL" ] || SMART_MODEL="$(getj "$SMART_JSON" '@.device.model_name')"
    SMART_SERIAL="$(getj "$SMART_JSON" '@.serial_number')"
    SMART_POWER_CYCLES="$(getj "$SMART_JSON" '@.power_cycle_count')"
    SMART_SELF_TEST_TYPE="$(getj "$SMART_JSON" '@.ata_smart_self_test_log.standard.table[0].type.string')"
    SMART_SELF_TEST_STATUS="$(getj "$SMART_JSON" '@.ata_smart_self_test_log.standard.table[0].status.string')"
    SMART_SELF_TEST_HOURS="$(getj "$SMART_JSON" '@.ata_smart_self_test_log.standard.table[0].lifetime_hours')"
    if [ "$SMART_PASSED" = "true" ]; then
      SMART_AVAILABLE=1
      SMART_HEALTH="정상"
    elif [ "$SMART_PASSED" = "false" ]; then
      SMART_AVAILABLE=1
      SMART_HEALTH="주의"
    else
      # 일부 USB-SATA 브리지는 상태 필드를 주지 않아도 온도/시간은 제공한다.
      if [ -n "$SMART_TEMP$SMART_HOURS$SMART_MODEL" ]; then
        SMART_AVAILABLE=1
        SMART_HEALTH="정보 확인"
      else
        SMART_REASON="USB 어댑터 또는 SSD가 SMART 전달을 지원하지 않습니다."
      fi
    fi
  else
    SMART_REASON="SMART 정보를 읽지 못했습니다. USB 어댑터의 SMART 통과 지원을 확인하십시오."
  fi
fi

json_init
json_add_object system
json_add_string hostname "${HOSTNAME:-OpenWrt}"
json_add_string model "${MODEL:-Unknown}"
json_add_string kernel "${KERNEL:-}"
json_add_string version "${VERSION:-}"
json_add_string revision "${REVISION:-}"
json_add_string lan_address "${LAN_ADDRESS:-}"
json_add_string lan_ipv4 "${LAN_IPV4:-}"
json_add_string lan_ipv6_global "${LAN_IPV6_GLOBAL:-}"
json_add_string lan_ipv6_link_local "${LAN_IPV6_LINK:-}"
json_add_int uptime "$(num_or_zero "$UPTIME")"
json_add_int cpu_percent "$(num_or_zero "$CPU_PERCENT")"
json_add_array load
json_add_int "" "$(num_or_zero "$LOAD1")"
json_add_int "" "$(num_or_zero "$LOAD5")"
json_add_int "" "$(num_or_zero "$LOAD15")"
json_close_array
json_add_object memory
json_add_int total "$(num_or_zero "$MEM_TOTAL")"
json_add_int free "$(num_or_zero "$MEM_FREE")"
json_add_int shared "$(num_or_zero "$MEM_SHARED")"
json_add_int buffered "$(num_or_zero "$MEM_BUFFERED")"
json_add_int available "$(num_or_zero "$MEM_AVAILABLE")"
json_close_object
json_close_object

json_add_object storage
json_add_boolean mounted "$STORAGE_MOUNTED"
json_add_string device "${STORAGE_DEVICE:-}"
json_add_string disk_device "${SMART_DEV:-}"
json_add_string filesystem "${STORAGE_FS:-}"
json_add_string mountpoint "${STORAGE_MOUNT:-}"
json_add_int total_kb "$(num_or_zero "$TOTAL_KB")"
json_add_int used_kb "$(num_or_zero "$USED_KB")"
json_add_int available_kb "$(num_or_zero "$AVAIL_KB")"
json_add_int used_percent "$(num_or_zero "$USED_PERCENT")"
json_add_string total_human "$TOTAL_HUMAN"
json_add_string used_human "$USED_HUMAN"
json_add_string available_human "$AVAIL_HUMAN"
json_add_boolean smart_available "$SMART_AVAILABLE"
json_add_string health "${SMART_HEALTH:-}"
json_add_string reason "${SMART_REASON:-}"
json_add_string model "${SMART_MODEL:-}"
json_add_string serial "${SMART_SERIAL:-}"
json_add_string smart_device_type "${SMART_DEVICE_TYPE:-auto}"
[ -n "$SMART_CHECKED_AT" ] && json_add_int checked_at "$(num_or_zero "$SMART_CHECKED_AT")"
[ -n "$SMART_LAST_TEST" ] && json_add_int last_smart_test "$(num_or_zero "$SMART_LAST_TEST")"
[ -n "$SMART_SELF_TEST_TYPE" ] && json_add_string self_test_type "$SMART_SELF_TEST_TYPE"
[ -n "$SMART_SELF_TEST_STATUS" ] && json_add_string self_test_status "$SMART_SELF_TEST_STATUS"
[ -n "$SMART_SELF_TEST_HOURS" ] && json_add_int self_test_lifetime_hours "$(num_or_zero "$SMART_SELF_TEST_HOURS")"
[ -n "$SMART_TEMP" ] && json_add_int temperature "$(num_or_zero "$SMART_TEMP")"
[ -n "$SMART_HOURS" ] && json_add_int power_on_hours "$(num_or_zero "$SMART_HOURS")"
[ -n "$SMART_POWER_CYCLES" ] && json_add_int power_cycle_count "$(num_or_zero "$SMART_POWER_CYCLES")"
json_close_object

json_add_int timestamp "$(date +%s)"
json_dump
