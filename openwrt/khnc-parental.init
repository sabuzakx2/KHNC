#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

ENFORCER=/usr/sbin/khnc-enforce

start_service() {
  [ -x "$ENFORCER" ] || return 0
  procd_open_instance
  procd_set_param command /bin/sh -c "while :; do $ENFORCER >/tmp/khnc-enforce.last 2>&1; sleep 60; done"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
