#!/bin/sh
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
CFG=/etc/khnc/infra.json
[ -r "$CFG" ] || CFG=/www/khnc/infra.json
esc(){ printf '%s' "$1"|sed 's/\\/\\\\/g;s/"/\\"/g'; }
check_ping(){ [ -n "$1" ] && ping -c 1 -W 1 "$1" >/dev/null 2>&1; }
check_port(){ [ -n "$1" ] && [ -n "$2" ] && nc -z -w 1 "$1" "$2" >/dev/null 2>&1; }
start_ms(){ date +%s 2>/dev/null; }
metric(){ printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1; }
router_lan_ip(){
  ADDRESS="$(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet 192\.168\./ {sub(/\/.*/,"",$2); print $2; exit}')"
  [ -n "$ADDRESS" ] || ADDRESS="$(ip -6 addr show dev br-lan scope global 2>/dev/null | awk '/inet6 / {sub(/\/.*/,"",$2); print $2; exit}')"
  [ -n "$ADDRESS" ] || ADDRESS="$(ip -6 addr show dev br-lan scope link 2>/dev/null | awk '/inet6 fe80:/ {sub(/\/.*/,"",$2); print $2; exit}')"
  printf '%s' "$ADDRESS"
}

collect_nas(){
  NAS_IP="$1"; NAS_USER="$2"; NAS_PORT="${3:-22}"; NAS_KEY="$4"
  [ -n "$NAS_IP" ] && [ -n "$NAS_USER" ] && [ -r "$NAS_KEY" ] || return 1
  NAS_RAW="$(ssh -p "$NAS_PORT" -i "$NAS_KEY" "$NAS_USER@$NAS_IP" '
    CPU_1=$(awk "/^cpu / {idle=\$5+\$6; total=0; for(i=2;i<=NF;i++) total+=\$i; print total, idle; exit}" /proc/stat)
    sleep 1
    CPU_2=$(awk "/^cpu / {idle=\$5+\$6; total=0; for(i=2;i<=NF;i++) total+=\$i; print total, idle; exit}" /proc/stat)
    set -- $CPU_1; CPU_TOTAL_1=$1; CPU_IDLE_1=$2
    set -- $CPU_2; CPU_TOTAL_2=$1; CPU_IDLE_2=$2
    CPU_DELTA=$((CPU_TOTAL_2-CPU_TOTAL_1)); CPU_IDLE_DELTA=$((CPU_IDLE_2-CPU_IDLE_1))
    if [ "$CPU_DELTA" -gt 0 ]; then CPU_USED=$(( (CPU_DELTA-CPU_IDLE_DELTA)*100/CPU_DELTA )); else CPU_USED=0; fi
    MEM_TOTAL=$(sed -n "s/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p" /proc/meminfo)
    MEM_AVAILABLE=$(sed -n "s/^MemAvailable:[[:space:]]*\([0-9]*\).*/\1/p" /proc/meminfo)
    [ -n "$MEM_AVAILABLE" ] || MEM_AVAILABLE=$(sed -n "s/^MemFree:[[:space:]]*\([0-9]*\).*/\1/p" /proc/meminfo)
    if [ -n "$MEM_TOTAL" ] && [ "$MEM_TOTAL" -gt 0 ]; then MEM_USED=$(( (MEM_TOTAL-MEM_AVAILABLE)*100/MEM_TOTAL )); else MEM_USED=0; fi
    DISK=$(df -P /volume* 2>/dev/null | awk "NR>1 && \$2>max {max=\$2; mount=\$6; used=\$5} END {gsub(/%/,\"\",used); if(mount) print mount \" \" used \"%\"}")
    DOCKER=""
    for BIN in /var/packages/ContainerManager/target/usr/bin/docker /var/packages/Docker/target/usr/bin/docker /usr/local/bin/docker /usr/bin/docker; do [ -x "$BIN" ] && DOCKER="$BIN" && break; done
    if [ -n "$DOCKER" ] && $DOCKER info >/dev/null 2>&1; then DOCKER_COUNT=$($DOCKER ps -q 2>/dev/null | wc -l | tr -d " "); else DOCKER_COUNT="권한 필요"; fi
    SMART="권한 필요"
    SMART_AT="-"
    PRIVILEGED=$(sudo -n /usr/local/bin/khnc-nas-metrics 2>/dev/null)
    if [ -n "$PRIVILEGED" ]; then
      PRIV_DOCKER=$(printf "%s\n" "$PRIVILEGED" | sed -n "s/^DOCKER=//p" | head -n 1)
      PRIV_SMART=$(printf "%s\n" "$PRIVILEGED" | sed -n "s/^SMART=//p" | head -n 1)
      PRIV_SMART_AT=$(printf "%s\n" "$PRIVILEGED" | sed -n "s/^SMART_AT=//p" | head -n 1)
      [ -n "$PRIV_DOCKER" ] && DOCKER_COUNT="$PRIV_DOCKER"
      [ -n "$PRIV_SMART" ] && SMART="$PRIV_SMART"
      [ -n "$PRIV_SMART_AT" ] && SMART_AT="$PRIV_SMART_AT"
    fi
    printf "CPU=%s%%\nMEMORY=%s%%\nDISK=%s\nDOCKER=%s\nSMART=%s\nSMART_AT=%s\n" "$CPU_USED" "$MEM_USED" "$DISK" "$DOCKER_COUNT" "$SMART" "$SMART_AT"
  ' </dev/null 2>/dev/null)" || return 1
  return 0
}
# Parse the simple shipped JSON with jsonfilter; IDs are fixed and user-editable values remain strings.
printf '{"equipment":['
FIRST=1
for ID in openwrt nas j1900 mac; do
  NAME="$(jsonfilter -i "$CFG" -e "@.equipment[@.id='$ID'].name" 2>/dev/null)"
  IP="$(jsonfilter -i "$CFG" -e "@.equipment[@.id='$ID'].ip" 2>/dev/null)"
  [ "$ID" = "openwrt" ] && IP="$(router_lan_ip)"
  SSH_USER="$(jsonfilter -i "$CFG" -e "@.equipment[@.id='$ID'].sshUser" 2>/dev/null)"
  SSH_PORT="$(jsonfilter -i "$CFG" -e "@.equipment[@.id='$ID'].sshPort" 2>/dev/null)"
  SSH_KEY="$(jsonfilter -i "$CFG" -e "@.equipment[@.id='$ID'].sshKey" 2>/dev/null)"
  if [ "$ID" = "nas" ]; then
    SSH_USER="${SSH_USER:-kallos}"
    SSH_PORT="${SSH_PORT:-2202}"
    SSH_KEY="${SSH_KEY:-/root/.ssh/khnc_nas_key}"
  fi
  [ -n "$NAME" ] || continue
  T0="$(date +%s%3N 2>/dev/null)"; check_ping "$IP"; OK=$?; T1="$(date +%s%3N 2>/dev/null)"
  case "$T0$T1" in *N*) MS=0;; *) MS=$((T1-T0));; esac
  [ "$FIRST" -eq 1 ] || printf ','; FIRST=0
  printf '{"id":"%s","name":"%s","ip":"%s","online":%s,"responseMs":%s' "$(esc "$ID")" "$(esc "$NAME")" "$(esc "$IP")" "$([ $OK -eq 0 ]&&echo true||echo false)" "$MS"
  if [ "$ID" = "nas" ] && [ "$OK" -eq 0 ] && collect_nas "$IP" "$SSH_USER" "$SSH_PORT" "$SSH_KEY"; then
    NAS_CPU="$(metric "$NAS_RAW" CPU)"; NAS_MEMORY="$(metric "$NAS_RAW" MEMORY)"; NAS_DISK="$(metric "$NAS_RAW" DISK)"
    NAS_DOCKER="$(metric "$NAS_RAW" DOCKER)"; NAS_SMART="$(metric "$NAS_RAW" SMART)"; NAS_SMART_AT="$(metric "$NAS_RAW" SMART_AT)"
    printf ',"cpu":"%s","memory":"%s","disk":"%s","smart":"%s","dockerCount":"%s","lastSmart":"%s"' "$(esc "${NAS_CPU:--}")" "$(esc "${NAS_MEMORY:--}")" "$(esc "${NAS_DISK:--}")" "$(esc "${NAS_SMART:-권한 필요}")" "$(esc "${NAS_DOCKER:-권한 필요}")" "$(esc "${NAS_SMART_AT:--}")"
  fi
  printf '}'
done
printf '],"services":['
FIRST=1
for ID in ha adguard tvh ollama n8n mqtt; do
  NAME="$(jsonfilter -i "$CFG" -e "@.services[@.id='$ID'].name" 2>/dev/null)"
  HOST="$(jsonfilter -i "$CFG" -e "@.services[@.id='$ID'].host" 2>/dev/null)"
  IP="$(jsonfilter -i "$CFG" -e "@.services[@.id='$ID'].ip" 2>/dev/null)"
  PORT="$(jsonfilter -i "$CFG" -e "@.services[@.id='$ID'].port" 2>/dev/null)"
  [ -n "$NAME" ] || continue
  T0="$(date +%s%3N 2>/dev/null)"; check_port "$IP" "$PORT"; OK=$?; T1="$(date +%s%3N 2>/dev/null)"
  case "$T0$T1" in *N*) MS=0;; *) MS=$((T1-T0));; esac
  [ "$FIRST" -eq 1 ] || printf ','; FIRST=0
  printf '{"id":"%s","name":"%s","host":"%s","ip":"%s","port":"%s","online":%s,"responseMs":%s}' "$(esc "$ID")" "$(esc "$NAME")" "$(esc "$HOST")" "$(esc "$IP")" "$(esc "$PORT")" "$([ $OK -eq 0 ]&&echo true||echo false)" "$MS"
done
printf '],"timestamp":%s}' "$(date +%s)"
